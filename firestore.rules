rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rrabir2004@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products: Public can read published products, only admins can write
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(productId);
    }

    // Categories: Public can read, admins can write
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    // Brands: Public can read, admins can write
    match /brands/{brandId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidId(brandId);
    }

    // Orders: Never allow public unrestricted list. Admin can read/write all.
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isSignedIn() || request.auth == null; // Handled primarily via trusted server function
      allow update, delete: if isAdmin() && isValidId(orderId);
    }

    // Store Settings: Public read, admin write
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Coupons: Public read for validation, admin write
    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if true;
      allow write: if isAdmin() && isValidId(couponId);
    }

    // Audit Logs: Admin read only, append-only
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId);
      allow update, delete: if false; // Immutable audit log
    }
  }
}
